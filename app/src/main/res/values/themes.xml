<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App theme: no ActionBar, Compose drives all UI. -->
    <style name="Theme.Pokedex" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen (androidx core-splashscreen). Shown at launch, then hands
         off to Theme.Pokedex via postSplashScreenTheme. -->
    <style name="Theme.Pokedex.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/pokeball</item>
        <item name="postSplashScreenTheme">@style/Theme.Pokedex</item>
    </style>

</resources>
